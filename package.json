{
  "name": "kicad-copilot-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.biosshot/kicad-copilot",
  "description": "File-oriented MCP server for KiCad schematics, PCB placement, and routing DSL workflows",
  "type": "module",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/biosshot/kicad-copilot",
    "type": "git"
  },
  "bin": {
    "kicad-copilot-mcp": "./dist/index.js",
    "kicad-copilot-cli": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsup",
    "mcp": "node dist/cli.js",
    "clean": "rimraf dist dist-tests",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "test:assemble": "npm run build && node dist-tests/assemble-schematic.js",
    "test:assembly-scenarios": "npm run build && node dist-tests/test-assembly-scenarios.js",
    "test:extract-regressions": "npm run build && node dist-tests/test-extract-regressions.js",
    "test:pcb-scenarios": "npm run build && node dist-tests/test-pcb-scenarios.js",
    "test:footprint-spec": "npm run build && node dist-tests/test-footprint-spec.js",
    "test:pcb-live": "npm run build && node dist-tests/test-pcb-live.js",
    "test:routing-live": "npm run build && node dist-tests/test-routing-live.js",
    "test:routing-integration": "npm run build && node dist-tests/test-routing-integration.js",
    "test:analysis": "npm run build && node dist-tests/test-analysis.js",
    "test:pcb-analysis": "node scripts/test-pcb-analysis-v2.mjs",
    "test:schematic-hierarchy": "npm run build && node dist-tests/test-schematic-hierarchy.js",
    "test:mcp-ldo": "npm run build && node dist-tests/test-mcp-ldo.js",
    "test:schematic-matrix": "npm run build && node dist-tests/test-schematic-matrix.js",
    "test:cli-sessions": "node scripts/test-cli-sessions.mjs",
    "test:cli-pcb-live": "node scripts/test-cli-pcb-live.mjs",
    "test:operations": "node scripts/test-local-layout-operation.mjs",
    "test:local-backend": "npm run build && node dist-tests/test-local-backend.js",
    "test:ground-layout": "npm run build && node dist-tests/test-ground-layout.js",
    "test:unit": "node dist-tests/test-footprint-spec.js && node dist-tests/test-analysis.js && npm run test:cli-sessions && npm run test:operations",
    "test:native": "node scripts/run-native-tests.mjs",
    "build:skill": "npm run build && node scripts/build-skill.mjs",
    "build:skill:bundled": "npm run build && node scripts/build-skill.mjs --bundled",
    "check:skill": "node scripts/check-skill.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm run build && npm run test:unit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check:release && npm run check",
    "start": "node dist/index.js",
    "test:checkpoint-concurrency": "node scripts/test-checkpoint-concurrency.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "clipper-lib": "6.4.2",
    "eda-copilot-backend": "0.5.1",
    "eda-copilot-router": "0.3.2",
    "fast-xml-parser": "^5.10.1",
    "find-up": "^5.0.0",
    "p-queue": "^9.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/clipper-lib": "6.4.0",
    "@types/node": "^25.0.0",
    "esbuild": "^0.27.7",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
